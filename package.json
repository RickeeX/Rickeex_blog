{
  "name": "rickeex-blog",
  "version": "2.3.0",
  "private": true,
  "scripts": {
    "generate": "velite",
    "dev": "npm run generate && concurrently \"velite --watch\" \"cross-env INIT_CWD=$PWD next dev\"",
    "build": "npm run generate && npm run build:site",
    "build:site": "cross-env INIT_CWD=$PWD next build --webpack && node scripts/finalize-export.mjs && node scripts/verify-export.mjs",
    "analyze": "npm run generate && cross-env ANALYZE=true INIT_CWD=$PWD next build --webpack && node scripts/finalize-export.mjs && node scripts/verify-export.mjs",
    "typecheck": "npm run generate && npm run typecheck:source",
    "typecheck:source": "tsc --noEmit --incremental false",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run generate && npm run check:source",
    "check:source": "npm run typecheck:source && npm run lint && npm run format:check",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.1.0",
    "@fontsource-variable/noto-sans-hk": "^5.1.0",
    "@fontsource-variable/noto-serif-hk": "^5.2.10",
    "@next/bundle-analyzer": "^16.3.1",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/typography": "^0.5.15",
    "autoprefixer": "^10.4.13",
    "github-slugger": "^2.0.0",
    "hast-util-from-html-isomorphic": "^2.0.0",
    "kbar": "^0.1.0-beta.47",
    "next": "^16.3.1",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.26",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "reading-time": "1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.0",
    "rehype-katex-notranslate": "^1.1.4",
    "rehype-prism-plus": "^2.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "remark-github-blockquote-alert": "^1.2.1",
    "remark-math": "^6.0.0",
    "server-only": "^0.0.1",
    "tailwindcss": "^3.4.17",
    "velite": "^0.2.4"
  },
  "devDependencies": {
    "@svgr/webpack": "^8.0.1",
    "@types/mdx": "^2.0.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "concurrently": "^9.2.4",
    "cross-env": "^7.0.3",
    "eslint": "^9.14.0",
    "eslint-config-next": "^16.3.1",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.0.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.0.0",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "typescript": "^5.1.3"
  },
  "overrides": {
    "kbar": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  },
  "lint-staged": {
    "*.+(js|jsx|ts|tsx)": [
      "eslint --fix"
    ],
    "*.+(js|jsx|ts|tsx|json|css|md|mdx)": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.9.0"
}
